<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>婚礼请帖</title>
    <style>
        /* ===== 你原来的代码，一点没改 ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #1a0e08;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .page-wrapper {
            width: 420px;
            max-width: 100%;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
            cursor: pointer;
            position: relative;
        }

        /* ===== 新增：页面容器（用来叠放两页） ===== */
        .pages-container {
            position: relative;
            width: 100%;
            height: 780px;
        }

        /* ===== 第一页：你原来的代码，完全保留 ===== */
        .page-1 {
            width: 100%;
            height: 780px;
            position: relative;
            overflow: hidden;
            background: #7C0414;
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        /* 第一页隐藏时（翻走） */
        .page-1.hide {
            opacity: 0;
            transform: scale(0.92);
            pointer-events: none;
        }

        /* ===== 第二页（新增） ===== */
        .page-2 {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #7C0414;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transform: scale(0.92);
            pointer-events: none;
            transition: opacity 0.6s ease, transform 0.6s ease;
            z-index: 1;
        }

        /* 第二页显示时 */
        .page-2.show {
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
            z-index: 3;
        }

        /* ===== 你原来的背景图层（完全保留） ===== */
        .bg-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .layer-1 {
            background-image: url('https://raw.githubusercontent.com/Leviredtea/Wedding/main/BG_0.png');
            opacity: 1;
        }

        .layer-2 {
            background-image: url('https://raw.githubusercontent.com/Leviredtea/Wedding/main/BG_1.png');
            opacity: 1;
            animation: slideInFromLeft 1.2s ease forwards;
        }

        @keyframes slideInFromLeft {
            0% {
                transform: translateX(-100%);
                opacity: 0;
            }
            100% {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* ===== 第二页内容 ===== */
        .test-text {
            font-size: 100px;
            color: #F5BE97;
            letter-spacing: 10px;
            position: relative;
            z-index: 2;
            font-family: 'Ma Shan Zheng', 'STKaiti', 'KaiTi', serif;
        }

        @media (max-width: 440px) {
            .pages-container,
            .page-1 {
                height: 70vh;
                min-height: 560px;
            }
            .test-text {
                font-size: 60px;
            }
        }
    </style>
</head>
<body>

    <div class="page-wrapper" id="wrapper">

        <div class="pages-container">

            <!-- ===== 第一页：你原来的代码，完全没动 ===== -->
            <div class="page-1" id="page1">
                <div class="bg-layer layer-1"></div>
                <div class="bg-layer layer-2"></div>
            </div>

            <!-- ===== 第二页：新增 ===== -->
            <div class="page-2" id="page2">
                <div class="test-text">Test</div>
            </div>

        </div>

    </div>

    <script>
        const wrapper = document.getElementById('wrapper');
        const page1 = document.getElementById('page1');
        const page2 = document.getElementById('page2');

        let isFlipping = false;
        let isPage2Visible = false;

        wrapper.addEventListener('click', function() {
            if (isFlipping) return;
            isFlipping = true;

            if (!isPage2Visible) {
                page1.classList.add('hide');
                page2.classList.add('show');
                isPage2Visible = true;
            } else {
                page1.classList.remove('hide');
                page2.classList.remove('show');
                isPage2Visible = false;
            }

            setTimeout(() => {
                isFlipping = false;
            }, 600);
        });
    </script>

</body>
</html>
